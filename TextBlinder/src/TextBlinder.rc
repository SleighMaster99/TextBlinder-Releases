#include <windows.h>
#include "Version.h"

#define TB_VERSION_DIGITS TB_VERSION_MAJOR, TB_VERSION_MINOR, TB_VERSION_PATCH, 0

VS_VERSION_INFO VERSIONINFO
FILEVERSION     TB_VERSION_DIGITS
PRODUCTVERSION  TB_VERSION_DIGITS
FILEFLAGSMASK   0x3fL
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_DLL
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "SleighMaster99"
            VALUE "FileDescription",  "TextBlinder - Notepad++ plugin that masks text on screen"
            VALUE "FileVersion",      TB_VERSION_STRING
            VALUE "InternalName",     "TextBlinder.dll"
            VALUE "LegalCopyright",   "Copyright (C) 2026 SleighMaster99. GPL v3."
            VALUE "OriginalFilename", "TextBlinder.dll"
            VALUE "ProductName",      "TextBlinder"
            VALUE "ProductVersion",   TB_VERSION_STRING
        END
    END
END
